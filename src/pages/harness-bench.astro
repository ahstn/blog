---
import { getCollection } from "astro:content";
import BenchChart from "../components/BenchChart.astro";
import BenchHeatmap from "../components/BenchHeatmap.astro";
import BenchTable from "../components/BenchTable.astro";
import BenchTradeoffs from "../components/BenchTradeoffs.astro";
import type { BenchTask } from "../content.config";
import Base from "../layouts/Base.astro";
import {
	aggregateRows,
	HARNESSES,
	LAST_RUN,
	LAST_RUN_V41,
	MODEL,
	SOURCE_URL,
	taskReportUrl,
	taskRows,
} from "../utils/harness-bench";

// Both suites use repo-backed data, not the CMS. Keep v4 as the default so
// existing /harness-bench#task-* links still point to the original table.
const isV41 = Astro.url.searchParams.get("version") === "4.1";
const version = isV41 ? "4.1" : "4";
type Entry = { id: string; data: BenchTask & { revision?: string } };
const tasks: Entry[] = (await getCollection(isV41 ? "harnessBenchV41" : "harnessBench"))
	.sort((a: Entry, b: Entry) => a.id.localeCompare(b.id));
const harnesses = HARNESSES.filter((h) => tasks.some(({ data }) => data.results.some((r) => r.harness === h)));
const common = tasks.filter(({ data }) => harnesses.every((h) => data.results.some((r) => r.harness === h)));
const aggregateSet = isV41 ? common : tasks;
const pairCount = tasks.reduce((n, { data }) => n + new Set(data.results.map((r) => r.harness)).size, 0);

const formatDate = (iso: string) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
		day: "numeric",
		month: "short",
		year: "numeric",
		timeZone: "UTC",
	});
---

<Base
	title="Harness Bench"
	description="Terminal-Bench 4 and 4.1 results: fractional scores, official passes, time, cache usage, and estimated cost by coding harness and task."
>
	<div class="bench-page">
		<header class="page-header">
			<h1 class="page-title">Harness Bench</h1>
			<p class="page-description">
				Coding agent harnesses on <code>{MODEL}</code> via OpenRouter at high reasoning.
				Pi runs without extensions unless noted.
			</p>
			<p class="page-meta">Results from <a href={SOURCE_URL}>ahstn/harness-bench</a>.</p>
		</header>

		<nav class="suite-tabs" aria-label="Terminal-Bench version">
			<a href="/harness-bench" aria-current={!isV41 ? "page" : undefined}>v4</a>
			<a href="/harness-bench?version=4.1" aria-current={isV41 ? "page" : undefined}>v4.1</a>
		</nav>
		<p class="suite-summary">
			<strong>Terminal-Bench {version}</strong> · {tasks.length} tasks · {harnesses.length} harnesses
			{`${isV41 ? ` · ${pairCount}/${tasks.length * harnesses.length} accepted pairs` : ""} · last run ${formatDate(isV41 ? LAST_RUN_V41 : LAST_RUN)}`}
		</p>

		<section class="bench-section" aria-labelledby="overall-heading">
			<h2 id="overall-heading">All tasks aggregated by harness</h2>
			<p class="section-description">
				{isV41 ? (
					<>
						The default view uses the same {common.length} tasks for all five harnesses, taking
						the newest accepted version per task. Exact-version rows cover only tasks with a result
						for that version. Official pass counts tasks with a pass over tasks included. Cache rate
						is summed cached input divided by summed input tokens, using captured calls only.
						Versions, routing presets and resource limits vary across cohorts.
					</>
				) : (
					<>
						Each harness across the tasks it ran, using the same versions as the chart. Official pass
						counts tasks with at least one pass over tasks included. The legacy cache column is
						cached tokens divided by total tokens, including output.
					</>
				)}
			</p>
			{isV41 && (
				<button type="button" class="version-toggle" aria-pressed="false" data-v41-all-versions>
					Show all harness versions
				</button>
			)}
			<BenchTable
				rows={aggregateRows(aggregateSet.map((t) => t.data), isV41 ? "input" : "total")}
				caption={isV41 ? "Results by harness on the shared task set" : "Results by harness across all tasks"}
				versionLabel={isV41 ? "Newest version included" : "Latest version"}
				cacheRead
				cacheLabel={isV41 ? "Cache rate" : undefined}
			/>
		</section>

		<section class="bench-section" aria-labelledby="chart-heading">
			<h2 id="chart-heading">Scores by task</h2>
			<p class="section-description">
				{isV41
					? "Versions and older results are in the task tables below."
					: "Each bar uses the newest harness version run on that task. Show all versions to compare older ones."}
				{" "}
				Fractional score credits partial repairs: weighted feature completion multiplied by regression preservation.
			</p>
			{isV41 ? <BenchHeatmap tasks={tasks} harnesses={harnesses} /> : <BenchChart tasks={tasks} />}
		</section>

		{isV41 && (
			<section class="bench-section" aria-labelledby="tradeoffs-heading">
				<h2 id="tradeoffs-heading">Score, cost and time</h2>
				<p class="section-description">Compare quality with the cost and agent time of the selected attempt.</p>
				<BenchTradeoffs tasks={tasks} />
			</section>
		)}

		<section class="bench-section" aria-labelledby="tasks-heading">
			<h2 id="tasks-heading">Results by task</h2>
			<p class="section-description">
				One row per exact harness version: its best attempt from the newest cohort that ran it.
				Agent time excludes setup and verification; total time covers the whole trial. ≥ marks
				token totals and prices that are lower bounds, mostly OpenCode's, whose child sessions
				aren't counted; N/A means the attempt has no captured metric. Prices are estimates at
				each cohort's captured reference rates, which differ between cohorts, not provider bills.
				Rows from different cohorts aren't controlled comparisons.
				{isV41 && " First attempt means the first accepted attempt. Cache rate uses captured input tokens; incomplete usage is not a full-run estimate."}
			</p>

			{
				tasks.map(({ id, data }) => (
					<article class="bench-task" id={`task-${id}`} aria-labelledby={`task-${id}-heading`}>
						<h3 id={`task-${id}-heading`} class="task-title">
							{id}
						</h3>
						<p class="task-description">{data.description}</p>
						<p class="task-meta">
							Best of three · <a href={taskReportUrl(id, data.revision)}>Source table and cohort reports</a>
						</p>
						<BenchTable
							rows={taskRows(data, data.revision)}
							caption={`${id} results by harness`}
							cacheRead={isV41}
							cacheLabel={isV41 ? "Cache rate" : undefined}
							firstScore={isV41}
						/>
					</article>
				))
			}

			<p class="footnotes">
				Each row reports the harness version's best attempt and counts official passes over the
				attempts that ran. ‡ marks a
				pair whose full score or official pass stopped it early, so it ran fewer than three attempts.
			</p>
		</section>
	</div>
</Base>

<script>
	const v41Toggle = document.querySelector<HTMLButtonElement>("[data-v41-all-versions]");
	v41Toggle?.addEventListener("click", () => {
		const all = v41Toggle.getAttribute("aria-pressed") !== "true";
		v41Toggle.setAttribute("aria-pressed", String(all));
		for (const scope of v41Toggle.closest(".bench-page")!.querySelectorAll("[data-version-scope]")) {
			scope.toggleAttribute("data-all", all);
		}
	});
</script>

<style>
	/* Chart-only categorical palette: one hue per harness, in HARNESSES order,
	   used by the chart bars and the matching table swatches. Validated (CVD
	   and normal-vision separation) against both page surfaces; the dark
	   column is the same hues stepped for the dark surface. */
	.bench-page {
		--series-1: light-dark(#2a78d6, #3987e5);
		--series-2: light-dark(#eb6834, #d95926);
		--series-3: light-dark(#1baf7a, #199e70);
		--series-4: light-dark(#eda100, #c98500);
		--series-5: light-dark(#e87ba4, #d55181);
		--series-6: light-dark(#008300, #008300);
		--series-7: light-dark(#4a3aa7, #9085e9);
		--series-8: light-dark(#e34948, #e66767);

		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	@supports not (color: light-dark(#000, #fff)) {
		.bench-page {
			--series-1: #2a78d6;
			--series-2: #eb6834;
			--series-3: #1baf7a;
			--series-4: #eda100;
			--series-5: #e87ba4;
			--series-6: #008300;
			--series-7: #4a3aa7;
			--series-8: #e34948;
		}
	}

	.page-header {
		max-width: var(--content-width);
		margin-bottom: var(--spacing-12);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.page-description {
		margin-top: var(--spacing-3);
		color: var(--color-text-secondary);
	}

	.page-description code {
		font-family: var(--font-mono);
		font-size: 0.875em;
	}

	.page-meta {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.page-meta a,
	.task-meta a {
		color: inherit;
	}

	.page-meta a:hover,
	.task-meta a:hover {
		color: var(--color-brand);
	}

	.suite-tabs {
		display: flex;
		gap: var(--spacing-2);
		border-bottom: 1px solid var(--color-border);
	}

	.suite-tabs a {
		min-width: 4.5rem;
		padding: var(--spacing-2) var(--spacing-4);
		border-bottom: 2px solid transparent;
		color: var(--color-text-secondary);
		font-weight: var(--font-weight-heading);
		text-align: center;
		text-decoration: none;
	}

	.suite-tabs a[aria-current="page"] {
		border-bottom-color: var(--color-brand);
		color: var(--color-brand);
	}

	.suite-tabs a:hover {
		color: var(--color-brand);
		background: var(--color-bg-subtle);
	}

	.suite-tabs a:focus-visible,
	.version-toggle:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: -2px;
	}

	.suite-summary {
		margin: var(--spacing-4) 0 var(--spacing-8);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.version-toggle {
		margin-bottom: var(--spacing-4);
		padding: var(--spacing-2) var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
		cursor: pointer;
	}

	.version-toggle[aria-pressed="true"],
	.version-toggle:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.bench-section + .bench-section {
		margin-top: var(--spacing-16);
	}

	.bench-section h2 {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
	}

	.section-description {
		margin: var(--spacing-2) 0 var(--spacing-6);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	/* Chart labels link here; clear the sticky header. */
	.bench-task {
		scroll-margin-top: calc(4rem + var(--spacing-6));
	}

	.bench-task + .bench-task {
		margin-top: var(--spacing-10);
	}

	.task-title {
		font-family: var(--font-mono);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
	}

	.task-description {
		margin-top: var(--spacing-1);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.task-meta {
		margin: var(--spacing-1) 0 var(--spacing-4);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}

	.footnotes {
		margin-top: var(--spacing-8);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}
</style>
