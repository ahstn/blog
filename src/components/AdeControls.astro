---
import Bot from "@lucide/astro/icons/bot";
import Calendar from "@lucide/astro/icons/calendar";
import Check from "@lucide/astro/icons/check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Code from "@lucide/astro/icons/code";
import Columns3 from "@lucide/astro/icons/columns-3";
import Cpu from "@lucide/astro/icons/cpu";
import EllipsisVertical from "@lucide/astro/icons/ellipsis-vertical";
import ListFilter from "@lucide/astro/icons/list-filter";
import Monitor from "@lucide/astro/icons/monitor";
import Plus from "@lucide/astro/icons/plus";
import Sparkles from "@lucide/astro/icons/sparkles";
import Star from "@lucide/astro/icons/star";
import Tag from "@lucide/astro/icons/tag";
import Type from "@lucide/astro/icons/type";
import X from "@lucide/astro/icons/x";
import { COLUMNS, type FilterField, isColumnHiddenByDefault } from "../utils/ades";

interface Props {
	fields: FilterField[];
	total: number;
}

const { fields, total } = Astro.props;

// Icons needed by client-rendered filter chips; cloned from a <template>.
const icons = {
	bot: Bot,
	calendar: Calendar,
	check: Check,
	"chevron-down": ChevronDown,
	code: Code,
	cpu: Cpu,
	"ellipsis-vertical": EllipsisVertical,
	monitor: Monitor,
	sparkles: Sparkles,
	star: Star,
	tag: Tag,
	type: Type,
	x: X,
};
const iconFor = (name: string) => icons[name as keyof typeof icons];

const visibleColumns = COLUMNS.filter((c) => !isColumnHiddenByDefault(c.key)).length;
---

<div class="ade-controls" data-ade-controls>
	<div class="toolbar">
		<div class="menu-anchor">
			<button
				type="button"
				class="tb-btn"
				aria-haspopup="menu"
				aria-expanded="false"
				data-menu-trigger
			>
				<ListFilter size={16} aria-hidden="true" />
				Filters
				<span class="badge" data-filter-count hidden>0</span>
			</button>
			<div class="menu" role="menu" aria-label="Add filter" hidden data-field-menu>
				{
					fields.map((f) => {
						const Icon = iconFor(f.icon);
						return (
							<button type="button" role="menuitem" class="menu-item" data-field={f.key}>
								<Icon size={16} aria-hidden="true" />
								{f.label}
							</button>
						);
					})
				}
			</div>
		</div>

		<p class="result-count" aria-live="polite" data-result-count>
			{total} entries
		</p>

		<div class="menu-anchor menu-anchor-end">
			<button
				type="button"
				class="tb-btn"
				aria-haspopup="menu"
				aria-expanded="false"
				data-menu-trigger
			>
				<Columns3 size={16} aria-hidden="true" />
				Columns
				<span class="badge" data-column-count>{visibleColumns}</span>
			</button>
			<div class="menu" role="menu" aria-labelledby="toggle-columns-label" hidden>
				<p class="menu-label" id="toggle-columns-label">Toggle Columns</p>
				{
					COLUMNS.map((c) => {
						const locked = "locked" in c && c.locked;
						return (
							<button
								type="button"
								role="menuitemcheckbox"
								class="menu-item"
								aria-checked={isColumnHiddenByDefault(c.key) ? "false" : "true"}
								aria-disabled={locked ? "true" : undefined}
								data-column={c.key}
							>
								<span class="check">
									<Check size={16} aria-hidden="true" />
								</span>
								{c.label}
							</button>
						);
					})
				}
			</div>
		</div>
	</div>

	<div class="filter-bar" data-filter-bar hidden>
		<div class="filter-chips" data-filter-chips></div>
		<div class="menu-anchor">
			<button
				type="button"
				class="tb-btn tb-icon"
				aria-label="Add filter"
				aria-haspopup="menu"
				aria-expanded="false"
				data-menu-trigger
			>
				<Plus size={16} aria-hidden="true" />
			</button>
			<div class="menu" role="menu" aria-label="Add filter" hidden data-field-menu>
				{
					fields.map((f) => {
						const Icon = iconFor(f.icon);
						return (
							<button type="button" role="menuitem" class="menu-item" data-field={f.key}>
								<Icon size={16} aria-hidden="true" />
								{f.label}
							</button>
						);
					})
				}
			</div>
		</div>
		<button type="button" class="tb-btn" data-clear-filters>Clear</button>
	</div>

	<script type="application/json" data-filter-fields set:html={JSON.stringify(fields)} />
	<template data-icons>
		{
			Object.entries(icons).map(([name, Icon]) => (
				<span data-icon={name}>
					<Icon size={16} aria-hidden="true" />
				</span>
			))
		}
	</template>
</div>

<script>
	import {
		COLUMNS,
		type ColumnKey,
		type FilterField,
		type FilterFieldType,
		type FilterRecord,
		isColumnHiddenByDefault,
	} from "../utils/ades";

	// ---------------------------------------------------------------- menus

	type Arity = 0 | 1 | 2 | "many";
	interface Operator {
		id: string;
		label: string;
		arity: Arity;
	}

	let openMenu: { trigger: HTMLButtonElement; panel: HTMLElement } | null = null;

	function closeMenu({ focus = false } = {}) {
		if (!openMenu) return;
		openMenu.panel.hidden = true;
		openMenu.trigger.setAttribute("aria-expanded", "false");
		if (focus) openMenu.trigger.focus();
		openMenu = null;
	}

	function menuItems(panel: HTMLElement) {
		return [...panel.querySelectorAll<HTMLElement>("[role^='menuitem'], input")].filter(
			(el) => !el.closest("[hidden]"),
		);
	}

	function showMenu(trigger: HTMLButtonElement, panel: HTMLElement) {
		closeMenu();
		panel.hidden = false;
		trigger.setAttribute("aria-expanded", "true");
		openMenu = { trigger, panel };
		menuItems(panel)[0]?.focus();
	}

	/** Wire a trigger button to the panel that follows it inside `.menu-anchor`. */
	function bindMenu(trigger: HTMLButtonElement) {
		const panel = trigger.nextElementSibling as HTMLElement;
		trigger.addEventListener("click", () => {
			if (openMenu?.panel === panel) closeMenu();
			else showMenu(trigger, panel);
		});
		panel.addEventListener("keydown", (event) => {
			if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
			const items = menuItems(panel);
			const index = items.indexOf(document.activeElement as HTMLElement);
			const next = event.key === "ArrowDown" ? index + 1 : index - 1;
			items[(next + items.length) % items.length]?.focus();
			event.preventDefault();
		});
		return panel;
	}

	// Capture phase: close stale menus before any click handler opens a new one.
	document.addEventListener(
		"click",
		(event) => {
			if (openMenu && !openMenu.panel.parentElement!.contains(event.target as Node)) closeMenu();
		},
		true,
	);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMenu({ focus: true });
	});

	// --------------------------------------------------------------- setup

	const root = document.querySelector<HTMLElement>("[data-ade-controls]")!;
	const fields: FilterField[] = JSON.parse(
		root.querySelector("[data-filter-fields]")!.textContent!,
	);
	const fieldByKey = new Map(fields.map((f) => [f.key, f]));
	const iconTemplate = root.querySelector<HTMLTemplateElement>("[data-icons]")!;

	function icon(name: string) {
		return iconTemplate.content.querySelector(`[data-icon="${name}"] svg`)!.cloneNode(true);
	}

	function el<K extends keyof HTMLElementTagNameMap>(
		tag: K,
		props: Partial<HTMLElementTagNameMap[K]> & Record<string, unknown> = {},
		...children: (Node | string)[]
	) {
		const node = document.createElement(tag);
		for (const [key, value] of Object.entries(props)) {
			if (key.startsWith("data-") || key.startsWith("aria-") || key === "role") {
				node.setAttribute(key, String(value));
			} else {
				(node as unknown as Record<string, unknown>)[key] = value;
			}
		}
		node.append(...children);
		return node;
	}

	for (const trigger of root.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")) {
		bindMenu(trigger);
	}

	const rows = [...document.querySelectorAll<HTMLTableRowElement>("[data-ade-table] tr[data-filter]")];
	const records = new Map(rows.map((row) => [row, JSON.parse(row.dataset.filter!) as FilterRecord]));

	// ------------------------------------------------------------- columns

	const COLUMNS_KEY = "ade-hidden-columns";
	const hiddenColumns = new Set<ColumnKey>(
		(() => {
			try {
				const stored = JSON.parse(localStorage.getItem(COLUMNS_KEY) ?? "null");
				if (Array.isArray(stored)) return stored;
			} catch {}
			return COLUMNS.filter((c) => isColumnHiddenByDefault(c.key)).map((c) => c.key);
		})(),
	);

	function applyColumns() {
		for (const cell of document.querySelectorAll<HTMLElement>("[data-ade-table] [data-col]")) {
			cell.hidden = hiddenColumns.has(cell.dataset.col as ColumnKey);
		}
		for (const item of root.querySelectorAll<HTMLElement>("[data-column]")) {
			item.setAttribute("aria-checked", String(!hiddenColumns.has(item.dataset.column as ColumnKey)));
		}
		root.querySelector("[data-column-count]")!.textContent = String(
			COLUMNS.length - hiddenColumns.size,
		);
	}

	root.addEventListener("click", (event) => {
		const item = (event.target as Element).closest<HTMLElement>("[data-column]");
		if (!item || item.getAttribute("aria-disabled") === "true") return;
		const key = item.dataset.column as ColumnKey;
		if (hiddenColumns.has(key)) hiddenColumns.delete(key);
		else hiddenColumns.add(key);
		localStorage.setItem(COLUMNS_KEY, JSON.stringify([...hiddenColumns]));
		applyColumns();
	});

	applyColumns();

	// ------------------------------------------------------------- filters

	const EMPTY_OPS: Operator[] = [
		{ id: "empty", label: "is empty", arity: 0 },
		{ id: "not-empty", label: "is not empty", arity: 0 },
	];

	const OPERATORS: Record<FilterFieldType, Operator[]> = {
		text: [
			{ id: "contains", label: "contains", arity: 1 },
			{ id: "not-contains", label: "does not contain", arity: 1 },
		],
		multi: [
			{ id: "any", label: "has any of", arity: "many" },
			{ id: "all", label: "has all of", arity: "many" },
			{ id: "none", label: "has none of", arity: "many" },
			...EMPTY_OPS,
		],
		option: [
			{ id: "any", label: "is any of", arity: "many" },
			{ id: "none", label: "is none of", arity: "many" },
			...EMPTY_OPS,
		],
		date: [
			{ id: "eq", label: "is", arity: 1 },
			{ id: "neq", label: "is not", arity: 1 },
			{ id: "lt", label: "is before", arity: 1 },
			{ id: "gt", label: "is after", arity: 1 },
			{ id: "lte", label: "is on or before", arity: 1 },
			{ id: "gte", label: "is on or after", arity: 1 },
			{ id: "between", label: "is between", arity: 2 },
			{ id: "not-between", label: "is not between", arity: 2 },
			...EMPTY_OPS,
		],
		number: [
			{ id: "eq", label: "is", arity: 1 },
			{ id: "neq", label: "is not", arity: 1 },
			{ id: "gt", label: "is greater than", arity: 1 },
			{ id: "lt", label: "is less than", arity: 1 },
			{ id: "gte", label: "is greater than or equal to", arity: 1 },
			{ id: "lte", label: "is less than or equal to", arity: 1 },
			{ id: "between", label: "is between", arity: 2 },
			{ id: "not-between", label: "is not between", arity: 2 },
			...EMPTY_OPS,
		],
	};

	interface Filter {
		field: ColumnKey;
		op: string;
		values: string[];
	}

	const operator = (f: Filter) =>
		OPERATORS[fieldByKey.get(f.field)!.type].find((o) => o.id === f.op)!;

	const isEmpty = (v: unknown) => v == null || v === "" || (Array.isArray(v) && v.length === 0);

	function matches(record: FilterRecord, filter: Filter): boolean {
		const field = fieldByKey.get(filter.field)!;
		const op = operator(filter);
		const value = record[filter.field as keyof FilterRecord];
		if (op.id === "empty") return isEmpty(value);
		if (op.id === "not-empty") return !isEmpty(value);

		// Incomplete filters (no value picked yet) don't filter anything out.
		const args = filter.values.filter((v) => v !== "");
		if (op.arity === "many" ? args.length === 0 : args.length < op.arity) return true;

		switch (field.type) {
			case "text": {
				const hit = String(value).toLowerCase().includes(args[0].toLowerCase());
				return op.id === "contains" ? hit : !hit;
			}
			case "multi":
			case "option": {
				const have = Array.isArray(value) ? value : value == null ? [] : [String(value)];
				if (op.id === "all") return args.every((a) => have.includes(a));
				const any = args.some((a) => have.includes(a));
				return op.id === "any" ? any : !any;
			}
			case "date":
			case "number": {
				// Dates are YYYY-MM, compared as YYYYMM numbers.
				const parse = (v: unknown) => Number(String(v).replace("-", ""));
				const negated = op.id === "neq" || op.id === "not-between";
				if (value == null) return negated;
				const v = parse(value);
				const [a, b] = args.map(parse);
				switch (op.id) {
					case "eq":
						return v === a;
					case "neq":
						return v !== a;
					case "lt":
						return v < a;
					case "gt":
						return v > a;
					case "lte":
						return v <= a;
					case "gte":
						return v >= a;
					case "between":
					case "not-between": {
						const [lo, hi] = a <= b ? [a, b] : [b, a];
						const inside = v >= lo && v <= hi;
						return op.id === "between" ? inside : !inside;
					}
				}
			}
		}
		return true;
	}

	const filters: Filter[] = [];
	const chipsEl = root.querySelector<HTMLElement>("[data-filter-chips]")!;
	const filterBar = root.querySelector<HTMLElement>("[data-filter-bar]")!;

	function applyFilters() {
		let shown = 0;
		for (const [row, record] of records) {
			row.hidden = !filters.every((f) => matches(record, f));
			if (!row.hidden) shown++;
		}
		for (const tbody of document.querySelectorAll("[data-ade-table] tbody")) {
			const emptyRow = tbody.querySelector<HTMLElement>("[data-empty-row]")!;
			emptyRow.hidden = !!tbody.querySelector("tr[data-filter]:not([hidden])");
		}

		root.querySelector("[data-result-count]")!.textContent =
			shown === rows.length ? `${rows.length} entries` : `Showing ${shown} of ${rows.length}`;
		const count = root.querySelector<HTMLElement>("[data-filter-count]")!;
		count.hidden = filters.length === 0;
		count.textContent = String(filters.length);
		filterBar.hidden = filters.length === 0;

		const url = new URL(location.href);
		if (filters.length) {
			url.searchParams.set("filters", JSON.stringify(filters.map((f) => [f.field, f.op, f.values])));
		} else {
			url.searchParams.delete("filters");
		}
		history.replaceState(history.state, "", url);
	}

	// -------------------------------------------------------- value editors

	function optionSummary(field: FilterField, values: string[]) {
		if (values.length === 0) return "Select…";
		if (values.length > 2) return `${values.length} selected`;
		return values.map((v) => field.options!.find((o) => o.value === v)?.label ?? v).join(", ");
	}

	function renderValueEditor(filter: Filter, container: HTMLElement) {
		const field = fieldByKey.get(filter.field)!;
		const op = operator(filter);
		container.replaceChildren();
		container.hidden = op.arity === 0;
		if (op.arity === 0) return;

		if (op.arity === "many") {
			const label = el("span", { className: "value-summary" }, optionSummary(field, filter.values));
			const trigger = el(
				"button",
				{
					type: "button",
					className: "chip-part chip-button",
					"aria-haspopup": "true",
					"aria-expanded": "false",
					"aria-label": `${field.label} values`,
				},
				label,
				icon("chevron-down"),
			);
			const list = el("div", { className: "option-list" });
			for (const option of field.options ?? []) {
				const input = el("input", {
					type: "checkbox",
					value: option.value,
					checked: filter.values.includes(option.value),
				});
				list.append(el("label", { className: "option" }, input, option.label));
			}
			const panel = el("div", { className: "menu menu-options", hidden: true }, list);
			if ((field.options?.length ?? 0) > 8) {
				const search = el("input", {
					type: "search",
					className: "option-search",
					placeholder: `Search ${field.label.toLowerCase()}…`,
					"aria-label": `Search ${field.label.toLowerCase()}`,
				});
				search.addEventListener("input", () => {
					const q = search.value.toLowerCase();
					for (const option of list.querySelectorAll<HTMLElement>(".option")) {
						option.hidden = !option.textContent!.toLowerCase().includes(q);
					}
				});
				panel.prepend(search);
			}
			list.addEventListener("change", () => {
				filter.values = [...list.querySelectorAll<HTMLInputElement>("input:checked")].map(
					(i) => i.value,
				);
				label.textContent = optionSummary(field, filter.values);
				label.classList.toggle("placeholder", filter.values.length === 0);
				applyFilters();
			});
			label.classList.toggle("placeholder", filter.values.length === 0);
			container.append(el("div", { className: "menu-anchor" }, trigger, panel));
			bindMenu(trigger);
			return;
		}

		const inputs: HTMLInputElement[] = [];
		for (let i = 0; i < op.arity; i++) {
			const input =
				field.type === "date"
					? el("input", { type: "month", placeholder: "YYYY-MM", pattern: "\\d{4}-\\d{2}" })
					: field.type === "number"
						? el("input", { type: "number", min: "0", inputMode: "numeric", placeholder: "0" })
						: el("input", { type: "text", placeholder: "Search…" });
			input.className = "chip-input";
			input.value = filter.values[i] ?? "";
			input.setAttribute("aria-label", op.arity === 2 ? `${field.label} ${i ? "to" : "from"}` : field.label);
			input.addEventListener("input", () => {
				filter.values = inputs.map((x) => x.value.trim());
				applyFilters();
			});
			inputs.push(input);
			if (i > 0) container.append(el("span", { className: "chip-and" }, "and"));
			container.append(input);
		}
	}

	function openValueEditor(container: HTMLElement) {
		const trigger = container.querySelector<HTMLButtonElement>("[aria-haspopup]");
		if (trigger) showMenu(trigger, trigger.nextElementSibling as HTMLElement);
		else container.querySelector("input")?.focus();
	}

	// ----------------------------------------------------------------- chips

	function addChip(filter: Filter, { focus = false } = {}) {
		const field = fieldByKey.get(filter.field)!;
		filters.push(filter);

		const select = el("select", { className: "chip-op", "aria-label": `${field.label} condition` });
		for (const op of OPERATORS[field.type]) {
			select.append(el("option", { value: op.id, selected: op.id === filter.op }, op.label));
		}
		const opWrap = el("span", { className: "chip-part chip-select" }, select, icon("chevron-down"));
		const value = el("span", { className: "chip-part chip-value" });

		const menuTrigger = el(
			"button",
			{
				type: "button",
				className: "chip-part chip-button chip-menu",
				"aria-label": `${field.label} filter options`,
				"aria-haspopup": "menu",
				"aria-expanded": "false",
			},
			icon("ellipsis-vertical"),
		);
		const remove = el(
			"button",
			{ type: "button", role: "menuitem", className: "menu-item" },
			icon("x"),
			"Remove filter",
		);
		const menu = el("div", { className: "menu menu-end", role: "menu", hidden: true }, remove);

		const chip = el(
			"div",
			{ className: "filter-chip", role: "group", "aria-label": `${field.label} filter` },
			el("span", { className: "chip-part chip-field" }, icon(field.icon), field.label),
			opWrap,
			value,
			el("div", { className: "menu-anchor" }, menuTrigger, menu),
		);
		bindMenu(menuTrigger);

		select.addEventListener("change", () => {
			const before = operator(filter).arity;
			filter.op = select.value;
			const after = operator(filter).arity;
			if (before !== after) {
				// Keep what we can: option lists stay lists, single values stay single.
				if ((before === "many") !== (after === "many")) filter.values = [];
				else if (typeof after === "number") filter.values = filter.values.slice(0, after);
				renderValueEditor(filter, value);
			}
			applyFilters();
		});

		remove.addEventListener("click", () => {
			closeMenu();
			filters.splice(filters.indexOf(filter), 1);
			chip.remove();
			applyFilters();
			const next =
				chipsEl.querySelector<HTMLElement>(".chip-menu") ??
				root.querySelector<HTMLElement>("[data-menu-trigger]");
			next?.focus();
		});

		renderValueEditor(filter, value);
		chipsEl.append(chip);
		applyFilters();
		if (focus) openValueEditor(value);
	}

	for (const menu of root.querySelectorAll<HTMLElement>("[data-field-menu]")) {
		menu.addEventListener("click", (event) => {
			const item = (event.target as Element).closest<HTMLElement>("[data-field]");
			if (!item) return;
			closeMenu();
			const field = fieldByKey.get(item.dataset.field as ColumnKey)!;
			addChip({ field: field.key, op: OPERATORS[field.type][0].id, values: [] }, { focus: true });
		});
	}

	root.querySelector("[data-clear-filters]")!.addEventListener("click", () => {
		filters.length = 0;
		chipsEl.replaceChildren();
		applyFilters();
		root.querySelector<HTMLElement>("[data-menu-trigger]")!.focus();
	});

	// Restore filters from ?filters=[[field, op, values], ...]
	try {
		const saved = JSON.parse(new URL(location.href).searchParams.get("filters") ?? "[]");
		for (const [key, op, values] of saved) {
			const field = fieldByKey.get(key);
			if (!field || !OPERATORS[field.type].some((o) => o.id === op) || !Array.isArray(values)) {
				continue;
			}
			addChip({ field: field.key, op, values: values.map(String) });
		}
	} catch {}
</script>

<style>
	.ade-controls {
		margin-bottom: var(--spacing-10);
	}

	.toolbar {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.result-count {
		margin: 0 auto 0 0;
		font-size: var(--font-size-sm);
