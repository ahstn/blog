---
import { agentIcon } from "../utils/agent-icons";
import type { Harness } from "../utils/harness-bench";
import OmpIcon from "./OmpIcon.astro";

interface Props {
	harness: Harness;
}

const { harness } = Astro.props;

// Harness names mapped to the agent names Lobe icons are keyed by (shared
// with the ADE page). OMP has no Lobe icon and uses its own mark; Prime Agent
// has neither, so it falls back to its initial.
const LOBE_NAMES: Partial<Record<Harness, string>> = {
	"Claude Code": "Claude Code",
	Copilot: "Copilot CLI",
	"OpenCode v2": "OpenCode",
	Pi: "Pi",
	Codex: "Codex",
	Hermes: "Hermes Agent",
};

const lobeName = LOBE_NAMES[harness];
const svg = lobeName ? agentIcon(lobeName) : undefined;
---

<span class="harness-icon" aria-hidden="true">
	{
		harness === "OMP" ? (
			<OmpIcon />
		) : svg ? (
			<Fragment set:html={svg} />
		) : (
			<span class="initial">{harness[0]}</span>
		)
	}
</span>

<style>
	/* Lobe SVGs are sized 1em; mono ones use currentColor. */
	.harness-icon {
		display: inline-flex;
		flex: none;
		font-size: 1rem;
		color: var(--color-text);
	}

	.initial {
		display: inline-grid;
		place-items: center;
		width: 1rem;
		height: 1rem;
		border-radius: 3px;
		background: var(--color-text);
		color: var(--color-bg);
		font-size: 0.6875em;
		font-weight: 700;
		line-height: 1;
	}
</style>
