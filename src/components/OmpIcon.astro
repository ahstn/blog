---
// Oh My Pi (OMP) mark. Lobe Icons has no OMP logo, so this stands in for one
// alongside the Lobe SVGs. Sized 1em to match them.

// Each instance needs its own gradient id: several icons share a page, and a
// duplicate id would point every icon at the first gradient.
const gradientId = `omp-mark-${crypto.randomUUID().slice(0, 8)}`;
---

<svg viewBox="0 0 64 64" width="1em" height="1em" aria-hidden="true">
	<defs>
		<linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="oklch(0.7 0.24 340)"></stop>
			<stop offset=".5" stop-color="oklch(0.62 0.21 295)"></stop>
			<stop offset="1" stop-color="oklch(0.81 0.14 200)"></stop>
		</linearGradient>
	</defs>
	<path fill={`url(#${gradientId})`} d="M10 14h44v9H43v33h-9V23h-9v22h-9V23H10z"></path>
</svg>
